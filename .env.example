# PLANNED variables — nothing reads these yet. Names only; never put real values here.

# From the Shopify Dev Dashboard app configuration.
# SHOPIFY_API_SECRET also verifies App Proxy request signatures.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL of your deployment. Must not contain "shopify" or "example".
SHOPIFY_APP_URL=
# Scopes the app requests (see README section 5; request the minimum).
SCOPES=

# Postgres connection string (Railway provides this).
DATABASE_URL=

# Reverse proxy / rate limiting configuration:
# Number of trusted reverse proxy hops between client and app (default 1: rightmost XFF entry).
TRUSTED_PROXY_HOPS=1
# Trust CF-Connecting-IP header from Cloudflare edge (default false; set to true only when behind Cloudflare).
TRUST_CF_CONNECTING_IP=false
